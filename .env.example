# ==============================================================================
# SismoWatch - Environment Variables Configuration Template
# ==============================================================================

# General Project Configuration
PROJECT_NAME=SismoWatch
ENVIRONMENT=production
TZ=UTC

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_secret_2026

# Least Privilege Database Roles (Exigido por la prueba)
SISMO_INGEST_USER=sismo_ingest
SISMO_INGEST_PASSWORD=ingest_secret_pass_2026

SISMO_TRANSFORM_USER=sismo_transform
SISMO_TRANSFORM_PASSWORD=transform_secret_pass_2026

SISMO_APP_USER=sismo_app_readonly
SISMO_APP_PASSWORD=readonly_app_secret_2026

# ==============================================================================
# MinIO Object Storage (Data Lakehouse S3)
# ==============================================================================
MINIO_ROOT_USER=sismowatch_admin
MINIO_ROOT_PASSWORD=sismowatch_secret_minio_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sismowatch-lake
AWS_ACCESS_KEY_ID=sismowatch_admin
AWS_SECRET_ACCESS_KEY=sismowatch_secret_minio_2026
AWS_DEFAULT_REGION=us-east-1

# ==============================================================================
# Apache Airflow Configuration
# ==============================================================================
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.2-python3.11
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=7kR1b_mOLjniX-Wicxaq3mUdEIh2PCi_Qk8zGEmcD_o=
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres_master_secret_2026@postgres:5432/sismowatch
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=SismoAirflowAdmin2026!

# ==============================================================================
# Security & JWT Authentication (RBAC)
# ==============================================================================
JWT_SECRET_KEY=baa52f74fb2963994ed09af14b08ee64715c8e5c50622b8cd703abe59738ff07
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Credenciales sembradas de usuario (nunca quemadas en código fuente)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SismoAdmin2026!Secret
ADMIN_EMAIL=admin@sismowatch.internal

VIEWER_USERNAME=viewer
VIEWER_PASSWORD=SismoViewer2026!
VIEWER_EMAIL=viewer@sismowatch.internal

# ==============================================================================
# Artificial Intelligence & Dual Engine Configuration
# ==============================================================================
# Proveedor principal: 'ollama' (local) o 'gemini' (cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# Opcional para motor en la nube:
GEMINI_API_KEY=

# ==============================================================================
# OpenMetadata / Governance Viewer Configuration
# ==============================================================================
OPENMETADATA_PORT=8585
OPENMETADATA_SERVER_URL=http://openmetadata-viewer:8585

# ==============================================================================
# USGS Live Feed & CARTO Basemaps Configuration
# ==============================================================================
USGS_REALTIME_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_HISTORICAL_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_HISTORICAL_COUNT_URL=https://earthquake.usgs.gov/fdsnws/event/1/count

CARTO_API_KEY=cb1_4vzx_1_c2e8d37b1e85e3709ad52c32
VITE_CARTO_API_KEY=cb1_4vzx_1_c2e8d37b1e85e3709ad52c32

